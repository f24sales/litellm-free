[Unit]
Description=LiteLLM Free WebUI and visitor model tests
ConditionPathExists=!%h/litellm-free/update/web-config/use-host
Wants=network-online.target
After=network-online.target litellm-database.service
Before=caddy.service

[Container]
Image=ghcr.io/litellm-free/update/scan:latest
Pull=never
ContainerName=litellm-free-webui-container
UserNS=keep-id
User=1000:1000
Network=core
NetworkAlias=litellm-free-webui
LogDriver=journald
NoNewPrivileges=true
ReadOnly=true
DropCapability=all
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=128m
Volume=%h/litellm-free/update/publication:/var/lib/litellm-free/publication:ro,z
Volume=%h/litellm-free/data:/var/lib/litellm-free/publication/data:ro,z
Volume=%h/litellm-free/update/web-state:/var/lib/litellm-free/state:rw,Z
Volume=%h/litellm-free/update/web-config/web.env:/etc/litellm-free-webui/web.env:ro,Z
Volume=%h/litellm-free/litellm-free-webui/catalog_store.py:/opt/litellm-free-webui/catalog_store.py:ro,z
Volume=%h/litellm-free/litellm-free-webui/catalog_export.py:/opt/litellm-free-webui/catalog_export.py:ro,z
Volume=%h/litellm-free/litellm-free-webui/importer/litellm_export.py:/opt/litellm-free-webui/litellm_export.py:ro,z
Volume=%h/litellm-free/litellm-free-webui/route_controls.py:/opt/litellm-free-webui/route_controls.py:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/model_details.html:/opt/litellm-free-webui/templates/model_details.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/demo.py:/opt/litellm-free-webui/demo.py:ro,z
Volume=%h/litellm-free/litellm-free-webui/importer/litellm_export.py:/opt/litellm-free-webui/litellm_export.py:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/index.html:/opt/litellm-free-webui/templates/index.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/static/local-time.js:/opt/litellm-free-webui/static/local-time.js:ro,z
Volume=%h/litellm-free/litellm-free-webui/static/demo.js:/opt/litellm-free-webui/static/demo.js:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/demo_rate_limit.html:/opt/litellm-free-webui/templates/demo_rate_limit.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/unavailable.html:/opt/litellm-free-webui/templates/unavailable.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/faq_platforms.html:/opt/litellm-free-webui/templates/faq_platforms.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/aggregator_dialogs.html:/opt/litellm-free-webui/templates/aggregator_dialogs.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/gateway_thinking.html:/opt/litellm-free-webui/templates/gateway_thinking.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/locales:/opt/litellm-free-webui/locales:ro,z
Volume=%h/litellm-free/litellm-free-webui/localization.py:/opt/litellm-free-webui/localization.py:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/social_image_meta.html:/opt/litellm-free-webui/templates/social_image_meta.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/static/brand/F24SALES_social-usp-v1.png:/opt/litellm-free-webui/static/brand/F24SALES_social-usp-v1.png:ro,z
Volume=%h/litellm-free/litellm-free-webui/web.py:/opt/litellm-free-webui/web.py:ro,z
Volume=%h/litellm-free/litellm-free-webui/templates/demo_form.html:/opt/litellm-free-webui/templates/demo_form.html:ro,z
Volume=%h/litellm-free/litellm-free-webui/static/style.css:/opt/litellm-free-webui/static/style.css:ro,z
Volume=%h/litellm-free/litellm-free-webui/static/catalog.js:/opt/litellm-free-webui/static/catalog.js:ro,z
Volume=%t/litellm-free:/run/litellm-free:rw,z
Volume=%t/litellm-free-tests:/run/litellm-free-tests:ro,z
Environment=FREE_WEB_UDS=/run/litellm-free/litellm-free-container.sock


Volume=%h/litellm-free/litellm-free-webui/web_settings.py:/opt/litellm-free-webui/web_settings.py:ro,z

[Service]
RuntimeDirectory=litellm-free litellm-free-tests
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
CPUQuota=100%
MemoryHigh=2G
MemoryMax=3G
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
ExecStartPost=/usr/bin/bash %h/litellm-free/litellm-free-webui/deploy/select-webui.sh container
