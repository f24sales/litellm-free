[Unit]
Description=GoAccess dashboards and shared Cloudflare log ingestion
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/safrano9999/goaccess-safrano9999:latest
Pull=never
ContainerName=litellm-free-goaccess
Network=core
NetworkAlias=litellm-free-goaccess
LogDriver=journald
NoNewPrivileges=true
DropCapability=all
EnvironmentFile=%h/safrano9999/goaccess-safrano9999/.env
Volume=goaccess-safrano9999.volume:/data:z
Volume=%h/.local/share/litellm-free-goaccess/logs:/legacy/f24/logs:ro,z
Volume=%h/.local/share/litellm-free-goaccess/report:/legacy/f24/report:ro,z
Volume=%h/safrano9999/goaccess-safrano9999/geoip:/geoip:ro,z
StopSignal=SIGTERM

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=60

[Install]
WantedBy=default.target
