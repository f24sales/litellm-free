#!/usr/bin/env python3
"""Update OpenClaw's config and verify the gateway's published provider catalog."""
import json
import os
import subprocess
import time

import refresh_common as common


def catalog_matches(payload, catalog):
    if not isinstance(payload, dict) or not isinstance(payload.get("models"), list):
        return False
    rows = payload["models"]
    expected = {catalog["id"] + "/" + model: common.render_model(
        "openclaw", model, catalog["metadata"].get(model, {})) for model in catalog["models"]}
    if payload.get("count") != len(rows):
        return False
    actual = {}
    seen = set()
    for row in rows:
        if not isinstance(row, dict) or not isinstance(row.get("key"), str):
            return False
        key = row["key"]
        if key in seen:
            return False
        seen.add(key)
        tags = row.get("tags") or []
        # The CLI also includes discovered routes outside the configured set.
        # Their presence does not mean that importing the current set failed.
        if key not in expected:
            if "configured" in tags:
                return False
            continue
        if "missing" in tags:
            return False
        if ("contextWindow" in expected[key]
                and row.get("contextWindow") != expected[key]["contextWindow"]):
            return False
        actual[key] = row
    return set(actual) == set(expected)


def update_runtime(environ, catalog, needs_reload):
    # Config is already committed by run_single; the gateway watches that file.
    # --refresh would rediscover unrelated providers and can block the gateway.
    # Check its published catalog instead of accepting a successful CLI exit alone.
    settings = {**os.environ, **environ}
    settings.setdefault("OPENCLAW_HANDSHAKE_TIMEOUT_MS", "30000")
    argv = ["openclaw", "models", "list", "--provider", catalog["id"], "--json"]
    for attempt in range(3):
        try:
            result = subprocess.run(argv, env=settings, capture_output=True, text=True, timeout=45)
            if (result.returncode == 0 and "Gateway is not running" not in result.stderr
                    and catalog_matches(json.loads(result.stdout), catalog)):
                return "gateway_catalog_verified"
        except (OSError, subprocess.TimeoutExpired, ValueError):
            pass
        if attempt < 2:
            time.sleep(2)
    raise common.RefreshError("OpenClaw gateway did not confirm the current provider catalog")


if __name__ == "__main__":
    raise SystemExit(common.client_main("openclaw", update_runtime))
