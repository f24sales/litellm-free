[Unit]
Description=Import verified F24 SALES models into the LiteLLM API
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/litellm-free
ExecStart=/usr/bin/python3 %h/litellm-free/import_litellm.py api --config %h/.config/litellm-free/config.conf --env-file %h/.config/litellm-free/.env
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
