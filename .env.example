# Copy to .env next to free_sync.py: cp .env.example .env && chmod 600 .env
# Never commit .env. Provider tokens remain the local desired values.

# Host/base URL. If URL has an explicit port, it takes precedence over LITELLM_PORT.
LITELLM_BASE_URL=http://localhost
LITELLM_PORT=4000
# Required every run: LiteLLM master key or an admin virtual key with management rights.
LITELLM_ADMIN_KEY=replace-with-your-litellm-admin-token

# Provider API tokens: paste actual values locally, never into this example.
# OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Kilo: https://kilo.ai/docs/gateway/authentication
KILO_API_KEY=
# Nous Portal: https://portal.nousresearch.com/
NOUS_API_KEY=
# OpenCode Zen: https://opencode.ai/auth
OPENCODE_API_KEY=
# NVIDIA Build: https://build.nvidia.com/
NVIDIA_API_KEY=

# Restricted LiteLLM client bearer, NOT a provider/admin token. After a full
# probe it is reconciled to green model routes only.
# Leave empty initially: generated through /key/generate and saved here (0600).
# On subsequent runs this bearer is reused. An existing key can also be pasted here.
CLIENT_KEY=
CLIENT_KEY_ALIAS=litellm-free
ACCESS_GROUP=litellm-free

# Local desired catalog (no secrets), with creation/update timestamps in UTC.
MODELS_FILE=./free_models.json
STATE_FILE=./free_sync_state.json
# Both files append; unchanged models produce no news entry.
RUN_LOG=./runs.log
NEWS_FILE=./news.md

# Optional f24-sales website: server-side only, never exposed to the browser.
# setup_web_key.py provisions a SEPARATE key; CLIENT_KEY stays unchanged.
FREE_WEB_LITELLM_BASE_URL=https://127.0.0.1
FREE_WEB_LITELLM_PORT=2001
FREE_WEB_LITELLM_API_KEY=
FREE_WEB_GUARDRAILS=litellm-free-web-pre_call,litellm-free-web-post_call
FREE_WEB_CLIENT_KEY_ALIAS=litellm-free-web
# Stable availability SOT consumed by f24-sales after each model probe.
FREE_WEB_SOURCE=./model_probe_results.json
# Optional override for the stable probe output path; no bearer is written there.
PROBE_SOT_FILE=./model_probe_results.json

# Research new model identities after a full scan. Blank queues a review job.
# Native adapter: codex (uses the CLI's existing login and live web search).
MODEL_REVIEW_AGENT=
MODEL_REVIEW_MODEL=
MODEL_REVIEW_TIMEOUT=900
# Other CLIs: a command receiving TASK.md on stdin and returning result JSON.
# Optional arguments can use {input}, {task}, {output}; no shell is invoked.
MODEL_REVIEW_COMMAND=
